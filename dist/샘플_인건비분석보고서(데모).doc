    <tbody><tr><td style="border:1pt solid #d1d5db;padding:3pt 6pt;font-size:9.5pt;line-height:1.25;font-family:'Malgun Gothic','맑은 고딕',sans-serif;">관리자</td><td class="r" style="border:1pt solid #d1d5db;padding:3pt 6pt;font-size:9.5pt;line-height:1.25;font-family:'Malgun Gothic','맑은 고딕',sans-serif;text-align:right;white-space:nowrap;">16,167</td><td class="r" style="border:1pt solid #d1d5db;padding:3pt 6pt;font-size:9.5pt;line-height:1.25;font-family:'Malgun Gothic','맑은 고딕',sans-serif;text-align:right;white-space:nowrap;">17,005</td><td class="r" style="border:1pt solid #d1d5db;padding:3pt 6pt;font-size:9.5pt;line-height:1.25;font-family:'Malgun Gothic','맑은 고딕',sans-serif;text-align:right;white-space:nowrap;">17,254</td><td class="r" style="border:1pt solid #d1d5db;padding:3pt 6pt;font-size:9.5pt;line-height:1.25;font-family:'Malgun Gothic','맑은 고딕',sans-serif;text-align:right;white-space:nowrap;">15,904</td><td class="r" style="border:1pt solid #d1d5db;padding:3pt 6pt;font-size:9.5pt;line-height:1.25;font-family:'Malgun Gothic','맑은 고딕',sans-serif;text-align:right;white-space:nowrap;">-</td><td class="r" style="border:1pt solid #d1d5db;padding:3pt 6pt;font-size:9.5pt;line-height:1.25;font-family:'Malgun Gothic','맑은 고딕',sans-serif;text-align:right;white-space:nowrap;">7 / 9</td></tr><tr><td style="border:1pt solid #d1d5db;padding:3pt 6pt;font-size:9.5pt;line-height:1.25;font-family:'Malgun Gothic','맑은 고딕',sans-serif;">상담사</td><td class="r" style="border:1pt solid #d1d5db;padding:3pt 6pt;font-size:9.5pt;line-height:1.25;font-family:'Malgun Gothic','맑은 고딕',sans-serif;text-align:right;white-space:nowrap;">12,206</td><td class="r" style="border:1pt solid #d1d5db;padding:3pt 6pt;font-size:9.5pt;line-height:1.25;font-family:'Malgun Gothic','맑은 고딕',sans-serif;text-align:right;white-space:nowrap;">12,823</td><td class="r" style="border:1pt solid #d1d5db;padding:3pt 6pt;font-size:9.5pt;line-height:1.25;font-family:'Malgun Gothic','맑은 고딕',sans-serif;text-align:right;white-space